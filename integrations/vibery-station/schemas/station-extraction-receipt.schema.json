{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibery.dev/schemas/station-extraction-receipt-v1.json",
  "title": "Station Extraction Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "command", "repository", "extractor", "artifacts", "result", "diagnostics"],
  "properties": {
    "schema": { "const": "station-extraction-receipt/v1" },
    "ok": { "const": true },
    "command": { "const": "station extract" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision", "tree_oid", "object_format"],
      "properties": {
        "url": { "type": "string", "pattern": "^(?:https?://[^/@\\s]+(?::[0-9]+)?/[^\\s?#]+|ssh://git@[^/@\\s]+(?::[0-9]+)?/[^\\s?#]+|git@[^/:\\s]+:/?[^\\s?#]+)$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree_oid": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "object_format": { "const": "sha1" }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "contract_version", "limits"],
      "properties": {
        "profile": { "const": "node-workspaces/v1" },
        "contract_version": { "const": 1 },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_tree_bytes", "max_manifest_count", "max_workspace_patterns", "max_manifest_bytes", "max_selected_manifest_bytes"],
          "properties": {
            "max_tree_bytes": { "const": 16777216 },
            "max_manifest_count": { "const": 512 },
            "max_workspace_patterns": { "const": 512 },
            "max_manifest_bytes": { "const": 1048576 },
            "max_selected_manifest_bytes": { "const": 8388608 }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "map"],
      "properties": {
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "bytes"],
          "properties": {
            "file": { "const": "station-evidence.json" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "bytes"],
          "properties": {
            "file": { "const": "station-map.json" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "snapshot_id", "mode", "rooms", "relations", "fallback", "fallback_reason_codes"],
      "properties": {
        "project_id": { "type": "string", "pattern": "^project-[a-f0-9]{64}$" },
        "snapshot_id": { "type": "string", "pattern": "^snapshot-[a-f0-9]{64}$" },
        "mode": { "enum": ["structural", "coarse"] },
        "rooms": { "type": "integer", "minimum": 1, "maximum": 64 },
        "relations": { "type": "integer", "minimum": 0 },
        "fallback": { "type": "boolean" },
        "fallback_reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^station-fallback/[a-z0-9]+(?:-[a-z0-9]+)*$" } }
      }
    },
    "diagnostics": { "type": "array", "maxItems": 0 }
  }
}
